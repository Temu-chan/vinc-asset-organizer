/* ───────────────────────── テーマ ───────────────────────── */

.ao-root {
    --bg: #1e2023;
    --surface: #26282c;
    --surface-2: #2e3135;
    --surface-3: #373a3f;
    --hover: #3d4147;
    --border: #3a3d42;
    --border-strong: #52565d;
    --text: #e9eaec;
    --text-dim: #a4a8ae;
    --text-faint: #72767d;
    --accent: #4c8df6;
    --accent-hover: #67a0ff;
    --accent-text: #ffffff;
    --accent-soft: rgba(76, 141, 246, 0.16);
    --success: #3cc287;
    --success-soft: rgba(60, 194, 135, 0.15);
    --warn: #f1b443;
    --warn-soft: rgba(241, 180, 67, 0.14);
    --danger: #ee6363;
    --danger-soft: rgba(238, 99, 99, 0.14);
    --auto: #a98bf8;
    --auto-soft: rgba(169, 139, 248, 0.17);
    --ext: #f28c4d;
    --ext-soft: rgba(242, 140, 77, 0.16);
    --shadow: rgba(0, 0, 0, 0.45);

    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    font-size: 12px;
}

.ao-root.light {
    --bg: #e6e7e9;
    --surface: #f4f5f6;
    --surface-2: #ffffff;
    --surface-3: #e9eaed;
    --hover: #dfe1e5;
    --border: #cdd0d5;
    --border-strong: #a9adb4;
    --text: #1d1f22;
    --text-dim: #575c64;
    --text-faint: #8a8f97;
    --accent: #2f73e0;
    --accent-hover: #3f82ef;
    --accent-soft: rgba(47, 115, 224, 0.12);
    --success: #1e9b63;
    --success-soft: rgba(30, 155, 99, 0.12);
    --warn: #b97a06;
    --warn-soft: rgba(214, 150, 20, 0.14);
    --danger: #cf3b3b;
    --danger-soft: rgba(207, 59, 59, 0.1);
    --auto: #7651e0;
    --auto-soft: rgba(118, 81, 224, 0.12);
    --ext: #c8601f;
    --ext-soft: rgba(200, 96, 31, 0.12);
    --shadow: rgba(0, 0, 0, 0.2);
}

/* ───────────────────────── 汎用 ───────────────────────── */

.ao-hrow {
    flex-direction: row;
    align-items: center;
}

.ao-grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-dim {
    color: var(--text-dim);
}

.ao-root Label.ao-dim {
    color: var(--text-dim);
}

.ao-root Label.ao-faint {
    color: var(--text-faint);
}

.ao-small {
    font-size: 11px;
}

.ao-wrap {
    white-space: normal;
}

.ao-ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ao-bold {
    -unity-font-style: bold;
}


.ao-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.ao-divider {
    height: 1px;
    background-color: var(--border);
    margin: 12px 0;
}

/* ───────────────────────── ボタン ───────────────────────── */

.ao-root .ao-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 28px;
    min-width: 28px;
    padding: 0 12px;
    margin: 0;
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 6px;
    background-color: var(--surface-3);
    color: var(--text);
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    font-size: 12px;
    transition-duration: 0.12s;
    transition-property: background-color, border-color;
    cursor: link;
}

.ao-root .ao-btn:hover {
    background-color: var(--hover);
    border-color: var(--border-strong);
}

.ao-root .ao-btn:active {
    background-color: var(--surface-2);
}

.ao-root .ao-btn:disabled {
    opacity: 0.4;
}

.ao-root .ao-btn.primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    -unity-font-style: bold;
}

.ao-root .ao-btn.primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
}

.ao-root .ao-btn.ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-dim);
}

.ao-root .ao-btn.ghost:hover {
    background-color: var(--surface-3);
    color: var(--text);
}

.ao-root .ao-btn.danger {
    color: var(--danger);
    border-color: var(--border);
    background-color: rgba(0, 0, 0, 0);
}

.ao-root .ao-btn.danger:hover {
    background-color: var(--danger-soft);
    border-color: var(--danger);
}

.ao-root .ao-btn.big {
    height: 34px;
    padding: 0 18px;
    font-size: 13px;
}

.ao-root .ao-btn.small {
    height: 22px;
    min-width: 22px;
    padding: 0 8px;
    font-size: 11px;
    border-radius: 5px;
}

.ao-root .ao-btn.ao-icon-btn {
    padding: 0;
    width: 28px;
}

.ao-root .ao-btn.small.ao-icon-btn {
    width: 22px;
}

.ao-btn .ao-icon {
    margin-right: 6px;
}

.ao-btn.ao-icon-btn .ao-icon {
    margin-right: 0;
}

.ao-root .ao-btn Label {
    color: var(--text);
}

.ao-root .ao-btn.primary Label {
    color: var(--accent-text);
    -unity-font-style: bold;
}

.ao-root .ao-btn.ghost Label {
    color: var(--text-dim);
}

.ao-btn-group {
    flex-direction: row;
    align-items: center;
}

.ao-btn-group > .ao-btn {
    margin-right: 6px;
}

/* ───────────────────────── 入力 ───────────────────────── */

.ao-textfield {
    position: relative;
    flex-grow: 1;
}

.ao-root .ao-input {
    margin: 0;
    flex-grow: 1;
}

.ao-root .ao-input > .unity-base-text-field__input,
.ao-root .ao-tag-input > .unity-base-text-field__input,
.ao-root .ao-ver-digit > .unity-base-text-field__input {
    background-color: var(--bg);
    border-color: var(--border-strong);
    border-width: 1px;
    border-radius: 6px;
    color: var(--text);
    padding: 0 8px;
    min-height: 28px;
    font-size: 12px;
}

.ao-root .ao-input:focus > .unity-base-text-field__input,
.ao-root .ao-ver-digit:focus > .unity-base-text-field__input {
    border-color: var(--accent);
}

.ao-root .ao-input.big > .unity-base-text-field__input {
    min-height: 36px;
    font-size: 15px;
    padding: 0 12px;
}

.ao-root .ao-input.is-error > .unity-base-text-field__input {
    border-color: var(--danger);
}

.ao-placeholder {
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    color: var(--text-faint);
}

.ao-root Label.ao-placeholder {
    color: var(--text-faint);
}

.ao-textfield.big .ao-placeholder {
    left: 14px;
    font-size: 15px;
}

.ao-field-label {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ao-field-help {
    margin-top: 6px;
    white-space: normal;
}

.ao-root Label.ao-msg-error { color: var(--danger); }
.ao-root Label.ao-msg-warn { color: var(--warn); }
.ao-root Label.ao-msg-ok { color: var(--success); }

/* ポップアップ */
.ao-root .unity-base-popup-field {
    margin: 0;
}

.ao-root .unity-base-popup-field__input {
    min-height: 28px;
    border-radius: 6px;
    background-color: var(--surface-3);
    border-color: var(--border-strong);
}

/* パス表示 */
.ao-path-pill {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    border-radius: 6px;
    background-color: var(--bg);
    border-width: 1px;
    border-color: var(--border);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ao-path-pill.is-hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.ao-path-pill > Label {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

/* ───────────────────────── スイッチ ───────────────────────── */

.ao-switch {
    flex-direction: row;
    align-items: center;
    cursor: link;
}

.ao-switch-track {
    width: 30px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--surface-3);
    border-width: 1px;
    border-color: var(--border-strong);
    margin-right: 8px;
    flex-shrink: 0;
    transition-duration: 0.15s;
    transition-property: background-color;
}

.ao-switch-knob {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--text-dim);
    transition-duration: 0.15s;
    transition-property: left, background-color;
}

.ao-switch.is-on .ao-switch-track {
    background-color: var(--accent);
    border-color: var(--accent);
}

.ao-switch.is-on .ao-switch-knob {
    left: 15px;
    background-color: #ffffff;
}

/* ───────────────────────── チェックボックス・矢印 ───────────────────────── */

.ao-check {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: var(--border-strong);
    background-color: var(--bg);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    transition-duration: 0.1s;
    transition-property: background-color, border-color;
}

.ao-check-mark {
    width: 5px;
    height: 9px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: #ffffff;
    rotate: 45deg;
    margin-top: -2px;
    display: none;
}

.ao-check-dash {
    width: 7px;
    height: 2px;
    background-color: #ffffff;
    display: none;
}

.ao-check.is-on,
.ao-check.is-partial {
    background-color: var(--accent);
    border-color: var(--accent);
}

.ao-check.is-on .ao-check-mark {
    display: flex;
}

.ao-check.is-partial .ao-check-dash {
    display: flex;
}

.ao-check.is-locked {
    background-color: var(--surface-3);
    border-color: var(--border-strong);
}

.ao-check.is-locked .ao-check-mark {
    border-color: var(--text-dim);
}

.ao-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    cursor: link;
}

.ao-arrow-glyph {
    width: 6px;
    height: 6px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-color: var(--text-dim);
    rotate: -45deg;
    transition-duration: 0.12s;
    transition-property: rotate;
}

.ao-arrow.is-open .ao-arrow-glyph {
    rotate: 45deg;
    margin-top: -3px;
}

.ao-arrow.is-empty .ao-arrow-glyph {
    display: none;
}

/* ───────────────────────── バッジ・タグ ───────────────────────── */

.ao-badge {
    height: 16px;
    padding: 0 5px;
    border-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 6px;
    flex-shrink: 0;
    background-color: var(--surface-3);
}

.ao-root Label.ao-badge { color: var(--text-dim); }
.ao-root Label.ao-badge.auto { color: var(--auto); background-color: var(--auto-soft); }
.ao-root Label.ao-badge.ext { color: var(--ext); background-color: var(--ext-soft); }
.ao-root Label.ao-badge.rule { color: var(--accent); background-color: var(--accent-soft); }
.ao-root Label.ao-badge.new { color: var(--success); background-color: var(--success-soft); }
.ao-root Label.ao-badge.warn { color: var(--warn); background-color: var(--warn-soft); }
.ao-root Label.ao-badge.danger { color: var(--danger); background-color: var(--danger-soft); }
.ao-root Label.ao-badge.done { color: var(--success); background-color: var(--success-soft); }

.ao-tag-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.ao-tag {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px 0 8px;
    border-radius: 10px;
    background-color: var(--accent-soft);
    margin: 2px 4px 2px 0;
}

.ao-tag.readonly {
    padding: 0 8px;
}

.ao-root .ao-tag Label {
    color: var(--accent);
    font-size: 11px;
}

.ao-tag-x {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-left: 2px;
    -unity-text-align: middle-center;
    font-size: 11px;
    cursor: link;
}

.ao-root Label.ao-tag-x {
    color: var(--accent);
}

.ao-tag-x:hover {
    background-color: var(--accent-soft);
}

.ao-tagfield {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 32px;
    padding: 2px 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--bg);
}

.ao-tagfield.is-focus {
    border-color: var(--accent);
}

.ao-tag-input-wrap {
    flex-grow: 1;
    min-width: 140px;
    position: relative;
    height: 24px;
}

.ao-root .ao-tag-input {
    margin: 0;
    flex-grow: 1;
}

.ao-root .ao-tag-input > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    min-height: 24px;
    padding: 0 4px;
}

.ao-tagfield .ao-placeholder {
    left: 5px;
}

/* ───────────────────────── ヘッダー ───────────────────────── */

.ao-header {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 14px;
    background-color: var(--surface);
    border-bottom-width: 1px;
    border-color: var(--border);
    flex-shrink: 0;
}

.ao-brand {
    flex-direction: row;
    align-items: center;
    width: 168px;
    flex-shrink: 0;
}

.ao-logo {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background-color: var(--accent);
    align-items: center;
    justify-content: center;
    margin-right: 8px;
}

.ao-root .ao-logo Label {
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 11px;
}

.ao-brand-title {
    -unity-font-style: bold;
    font-size: 13px;
}

.ao-root Label.ao-brand-sub {
    font-size: 10px;
    color: var(--text-faint);
}

.ao-search {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    max-width: 520px;
    height: 30px;
    padding: 0 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--bg);
}

.ao-search.is-focus {
    border-color: var(--accent);
}

.ao-search .ao-textfield {
    margin-left: 6px;
}

.ao-root .ao-search .ao-input > .unity-base-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    min-height: 26px;
    padding: 0 2px;
}

.ao-search .ao-placeholder {
    left: 4px;
}

.ao-search-pop {
    position: absolute;
    top: 44px;
    left: 196px;
    width: 520px;
    max-height: 420px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 10px;
    padding: 6px;
    display: none;
}

.ao-search-pop.is-open {
    display: flex;
}

.ao-search-item {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    border-radius: 6px;
    cursor: link;
}

.ao-search-item:hover,
.ao-search-item.is-active {
    background-color: var(--accent-soft);
}

.ao-search-empty {
    padding: 14px;
    white-space: normal;
}

/* ───────────────────────── サイドバー ───────────────────────── */

.ao-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-sidebar {
    width: 182px;
    flex-shrink: 0;
    padding: 12px 10px;
    background-color: var(--surface);
    border-right-width: 1px;
    border-color: var(--border);
}

.ao-nav-item {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    margin-bottom: 3px;
    border-radius: 7px;
    cursor: link;
    transition-duration: 0.1s;
    transition-property: background-color;
}

.ao-nav-item:hover {
    background-color: var(--surface-3);
}

.ao-nav-item.is-active {
    background-color: var(--accent-soft);
}

.ao-root .ao-nav-item Label {
    margin-left: 10px;
    color: var(--text-dim);
    font-size: 12px;
}

.ao-root .ao-nav-item.is-active Label {
    color: var(--accent);
    -unity-font-style: bold;
}

.ao-nav-num {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--surface-3);
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
}

.ao-root Label.ao-nav-num {
    margin-left: 0;
    color: var(--text-dim);
}

.ao-root .ao-nav-item.is-active Label.ao-nav-num {
    background-color: var(--accent);
    color: #ffffff;
}

.ao-nav-section {
    margin: 14px 10px 6px 10px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.ao-root Label.ao-nav-section {
    color: var(--text-faint);
}

.ao-sidebar-footer {
    flex-grow: 1;
    justify-content: flex-end;
}

/* ───────────────────────── ページ ───────────────────────── */

.ao-content {
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-page-host {
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-page {
    flex-grow: 1;
    padding: 22px 26px 26px 26px;
}

.ao-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-root .ao-scroll-content {
    padding: 22px 26px 30px 26px;
}

.ao-page-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.ao-page-title {
    font-size: 19px;
    -unity-font-style: bold;
}

.ao-page-sub {
    margin-bottom: 16px;
    white-space: normal;
}

.ao-root Label.ao-page-sub {
    color: var(--text-dim);
}

.ao-back {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    cursor: link;
}

.ao-root .ao-back Label {
    color: var(--text-dim);
}

.ao-back:hover Label {
    color: var(--accent);
}

/* 2 列 */
.ao-split {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-list-pane {
    width: 260px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    padding: 14px 10px 10px 10px;
}

.ao-list-pane-head {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 10px 4px;
}

.ao-list-title {
    -unity-font-style: bold;
    font-size: 13px;
    flex-grow: 1;
}

.ao-detail-pane {
    flex-grow: 1;
    flex-shrink: 1;
}

.ao-list-item {
    padding: 9px 10px;
    border-radius: 7px;
    margin-bottom: 2px;
    cursor: link;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.ao-list-item:hover {
    background-color: var(--surface-3);
}

.ao-list-item.is-active {
    background-color: var(--accent-soft);
    border-color: var(--accent);
}

.ao-list-item-title {
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ao-list-item-sub {
    font-size: 11px;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ao-root Label.ao-list-item-sub {
    color: var(--text-faint);
}

.ao-list-empty {
    padding: 16px 8px;
    white-space: normal;
    -unity-text-align: upper-center;
}

/* ───────────────────────── カード・セクション ───────────────────────── */

.ao-card {
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    margin-bottom: 14px;
}

.ao-card.flat {
    background-color: var(--surface-2);
}

.ao-card.accent {
    border-color: var(--accent);
}

.ao-section-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.ao-section-num {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--accent);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    margin-right: 10px;
    flex-shrink: 0;
}

.ao-root Label.ao-section-num {
    color: #ffffff;
}

.ao-section-num.is-done {
    background-color: var(--success);
}

.ao-section-title {
    font-size: 13px;
    -unity-font-style: bold;
}

.ao-kv {
    flex-direction: row;
    margin-bottom: 6px;
}

.ao-kv-key {
    width: 110px;
    flex-shrink: 0;
}

.ao-root Label.ao-kv-key {
    color: var(--text-faint);
}

.ao-kv-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.ao-footer-bar {
    flex-direction: row;
    align-items: center;
    padding: 12px 26px;
    border-top-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    flex-shrink: 0;
}

/* ───────────────────────── ヒント ───────────────────────── */

.ao-hint {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: 8px;
    border-left-width: 3px;
    border-color: var(--accent);
    background-color: var(--accent-soft);
    margin-bottom: 14px;
}

.ao-hint.warn {
    border-color: var(--warn);
    background-color: var(--warn-soft);
}

.ao-hint.success {
    border-color: var(--success);
    background-color: var(--success-soft);
}

.ao-hint.danger {
    border-color: var(--danger);
    background-color: var(--danger-soft);
}

.ao-hint-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
}

.ao-hint-title {
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
}

.ao-hint-text {
    white-space: normal;
}

.ao-root Label.ao-hint-text {
    color: var(--text-dim);
}

.ao-hint-close {
    width: 18px;
    height: 18px;
    -unity-text-align: middle-center;
    border-radius: 4px;
    cursor: link;
}

.ao-root Label.ao-hint-close {
    color: var(--text-faint);
}

.ao-hint-close:hover {
    background-color: var(--surface-3);
}

/* ───────────────────────── ホーム ───────────────────────── */

.ao-hero {
    padding: 22px 24px;
    border-radius: 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    margin-bottom: 18px;
}

.ao-hero-title {
    font-size: 21px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ao-hero-text {
    white-space: normal;
}

.ao-root Label.ao-hero-text {
    color: var(--text-dim);
}

.ao-steps-row {
    flex-direction: row;
    align-items: stretch;
    margin: 0 -6px 18px -6px;
}

.ao-step-card {
    flex-grow: 1;
    flex-basis: 0;
    padding: 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    margin: 0 6px;
}

.ao-step-card.is-next {
    border-color: var(--accent);
    background-color: var(--surface-2);
}

.ao-step-card.is-done {
    border-color: var(--success);
}

.ao-step-card-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.ao-step-card-text {
    white-space: normal;
    flex-grow: 1;
    margin-bottom: 12px;
}

.ao-root Label.ao-step-card-text {
    color: var(--text-dim);
}

.ao-step-status {
    margin-left: 8px;
}

/* ───────────────────────── ウィザードのステップ表示 ───────────────────────── */

.ao-stepper {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.ao-stepper-item {
    flex-direction: row;
    align-items: center;
    cursor: link;
}

.ao-stepper-item.is-disabled {
    cursor: arrow;
    opacity: 0.5;
}

.ao-stepper-dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 1.5px;
    border-color: var(--border-strong);
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
}

.ao-root Label.ao-stepper-dot {
    color: var(--text-dim);
}

.ao-stepper-label {
    margin-left: 7px;
}

.ao-root Label.ao-stepper-label {
    color: var(--text-dim);
}

.ao-stepper-item.is-active .ao-stepper-dot {
    background-color: var(--accent);
    border-color: var(--accent);
}

.ao-root .ao-stepper-item.is-active Label.ao-stepper-dot {
    color: #ffffff;
}

.ao-root .ao-stepper-item.is-active Label.ao-stepper-label {
    color: var(--text);
    -unity-font-style: bold;
}

.ao-stepper-item.is-done .ao-stepper-dot {
    background-color: var(--success-soft);
    border-color: var(--success);
}

.ao-root .ao-stepper-item.is-done Label.ao-stepper-dot {
    color: var(--success);
}

.ao-stepper-line {
    flex-grow: 1;
    height: 1.5px;
    min-width: 16px;
    margin: 0 10px;
    background-color: var(--border-strong);
}

/* ───────────────────────── 選択カード ───────────────────────── */

.ao-choice-row {
    flex-direction: row;
    align-items: stretch;
    margin: 0 -6px;
}

.ao-choice {
    flex-grow: 1;
    flex-basis: 0;
    padding: 16px 18px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: var(--border);
    background-color: var(--surface);
    margin: 0 6px;
    cursor: link;
    transition-duration: 0.12s;
    transition-property: border-color, background-color;
}

.ao-choice:hover {
    border-color: var(--border-strong);
    background-color: var(--surface-2);
}

.ao-choice.is-on {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.ao-choice-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.ao-radio {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: var(--border-strong);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.ao-radio-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--accent);
    display: none;
}

.ao-choice.is-on .ao-radio {
    border-color: var(--accent);
}

.ao-choice.is-on .ao-radio-dot {
    display: flex;
}

.ao-choice-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.ao-choice-text {
    white-space: normal;
}

.ao-root Label.ao-choice-text {
    color: var(--text-dim);
}

/* ───────────────────────── ドロップゾーン ───────────────────────── */

.ao-dropzone {
    align-items: center;
    justify-content: center;
    padding: 26px 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--border-strong);
    background-color: var(--surface);
    transition-duration: 0.12s;
    transition-property: border-color, background-color;
}

.ao-dropzone.is-hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.ao-dropzone-icon {
    width: 34px;
    height: 34px;
    margin-bottom: 8px;
    opacity: 0.8;
}

.ao-dropzone-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.ao-dropzone-text {
    white-space: normal;
    -unity-text-align: middle-center;
}

.ao-root Label.ao-dropzone-text {
    color: var(--text-dim);
}

.ao-seed-item {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    border-radius: 7px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    margin-top: 6px;
}

/* ───────────────────────── ツリー ───────────────────────── */

.ao-tree {
    border-width: 1px;
    border-color: var(--border);
    border-radius: 8px;
    background-color: var(--bg);
    padding: 4px 0;
}

.ao-tree-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-right: 8px;
    padding-left: 6px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.ao-tree-row:hover {
    background-color: var(--surface-2);
}

.ao-tree-row.is-selected {
    background-color: var(--accent-soft);
}

.ao-tree-row.is-click {
    cursor: link;
}

.ao-tree-row.drop-before {
    border-top-color: var(--accent);
}

.ao-tree-row.drop-after {
    border-bottom-color: var(--accent);
}

.ao-tree-row.drop-inside {
    background-color: var(--accent-soft);
}

.ao-tree-row.is-dragging {
    opacity: 0.4;
}

.ao-tree-row .ao-check {
    margin-left: 2px;
    margin-right: 7px;
}

.ao-tree-row .ao-icon {
    margin-right: 6px;
}

.ao-tree-name {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ao-tree-row.is-off .ao-tree-name {
    opacity: 0.55;
}

.ao-tree-row.is-root .ao-tree-name {
    -unity-font-style: bold;
}

.ao-tree-prefix {
    font-size: 11px;
}

.ao-root Label.ao-tree-prefix {
    color: var(--text-faint);
}

.ao-tree-reason {
    margin-left: 10px;
    font-size: 10px;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
}

.ao-root Label.ao-tree-reason {
    color: var(--text-faint);
}

.ao-tree-handle {
    width: 14px;
    height: 20px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    cursor: move-arrow;
    opacity: 0.5;
}

.ao-tree-handle:hover {
    opacity: 1;
}

.ao-tree-handle-dots {
    width: 6px;
    height: 10px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: var(--text-dim);
}

.ao-row-actions {
    flex-direction: row;
    align-items: center;
    display: none;
    margin-left: 6px;
}

.ao-tree-row:hover .ao-row-actions,
.ao-tree-row.is-selected .ao-row-actions {
    display: flex;
}

.ao-root .ao-tree-rename {
    margin: 0;
    flex-grow: 1;
    max-width: 280px;
}

.ao-root .ao-tree-rename > .unity-base-text-field__input {
    min-height: 22px;
    background-color: var(--bg);
    border-color: var(--accent);
    border-radius: 4px;
}

/* 仮想化リスト（アセットツリー） */
.ao-asset-list {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 8px;
    background-color: var(--bg);
}

.ao-asset-list .unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
}

.ao-asset-list .unity-list-view__item:hover {
    background-color: var(--surface-2);
}

.ao-asset-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 8px 0 6px;
    cursor: link;
}

.ao-asset-row.is-anchor {
    background-color: var(--accent-soft);
}

.ao-asset-row.is-off .ao-tree-name {
    opacity: 0.6;
}

.ao-asset-row.is-group .ao-tree-name {
    -unity-font-style: bold;
}

.ao-asset-row .ao-check {
    margin-right: 7px;
}

.ao-asset-row .ao-icon {
    margin-right: 6px;
}

.ao-ping {
    display: none;
    margin-left: 6px;
}

.ao-asset-row:hover .ao-ping {
    display: flex;
}

.ao-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    flex-wrap: wrap;
}

.ao-legend {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
}

.ao-legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.ao-legend-item .ao-badge {
    margin-left: 0;
    margin-right: 5px;
}

/* ───────────────────────── セグメント ───────────────────────── */

.ao-seg {
    flex-direction: row;
    align-items: center;
    padding: 3px;
    border-radius: 8px;
    background-color: var(--surface-3);
}

.ao-seg-item {
    flex-shrink: 0;
    white-space: nowrap;
    height: 26px;
    padding: 0 14px;
    border-radius: 6px;
    -unity-text-align: middle-center;
    cursor: link;
    transition-duration: 0.1s;
    transition-property: background-color;
}

.ao-root Label.ao-seg-item {
    color: var(--text-dim);
}

.ao-seg-item:hover {
    background-color: var(--hover);
}

.ao-seg-item.is-on {
    background-color: var(--surface-2);
}

.ao-root Label.ao-seg-item.is-on {
    color: var(--text);
    -unity-font-style: bold;
}

.ao-seg.small .ao-seg-item {
    height: 22px;
    padding: 0 10px;
    font-size: 11px;
}

/* ───────────────────────── エクスポートのバナー ───────────────────────── */

.ao-banner {
    padding: 18px 20px;
    border-radius: 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    margin-bottom: 14px;
}

.ao-banner-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.ao-banner-name {
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.ao-joint {
    font-size: 16px;
    margin: 0 3px;
    -unity-font-style: bold;
}

.ao-root Label.ao-joint {
    color: var(--text-faint);
}

.ao-joint.is-hidden {
    display: none;
}

.ao-chip {
    height: 30px;
    padding: 0 12px;
    border-radius: 15px;
    border-width: 1.5px;
    border-color: var(--border-strong);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    font-size: 13px;
    cursor: link;
    margin: 3px 0;
    transition-duration: 0.12s;
    transition-property: background-color, border-color;
}

.ao-root Label.ao-chip {
    color: var(--text-faint);
}

.ao-chip:hover {
    border-color: var(--accent);
}

.ao-chip.is-on {
    background-color: var(--accent);
    border-color: var(--accent);
}

.ao-root Label.ao-chip.is-on {
    color: #ffffff;
    -unity-font-style: bold;
}

.ao-chip.debug.is-on {
    background-color: var(--warn);
    border-color: var(--warn);
}

.ao-root Label.ao-chip.debug.is-on {
    color: #1b1b1b;
}

.ao-chip.small {
    height: 24px;
    padding: 0 10px;
    border-radius: 12px;
    font-size: 11px;
}

.ao-filename {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    background-color: var(--bg);
}

.ao-filename-text {
    font-size: 13px;
    -unity-font-style: bold;
    flex-shrink: 1;
    white-space: normal;
}

.ao-ver-panel {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
}

/* ───────────────────────── バージョン ───────────────────────── */

.ao-ver {
    flex-direction: row;
    align-items: center;
}

.ao-ver-prefix {
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.ao-ver-col {
    align-items: center;
}

.ao-root .ao-ver-arrow {
    width: 30px;
    height: 16px;
    min-width: 0;
    padding: 0;
    border-radius: 4px;
    font-size: 8px;
    border-width: 0;
    background-color: var(--surface-3);
}

.ao-root .ao-ver-arrow:hover {
    background-color: var(--accent);
    color: #ffffff;
}

.ao-root .ao-ver-digit {
    margin: 2px 0;
    width: 30px;
}

.ao-root .ao-ver-digit > .unity-base-text-field__input {
    min-height: 30px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ao-ver-dot {
    font-size: 18px;
    -unity-font-style: bold;
    margin: 0 3px;
}

.ao-ver.compact .ao-ver-prefix {
    font-size: 11px;
    margin-right: 4px;
}

.ao-root .ao-ver.compact .ao-ver-arrow {
    width: 20px;
    height: 10px;
    font-size: 6px;
}

.ao-root .ao-ver.compact .ao-ver-digit {
    width: 20px;
    margin: 1px 0;
}

.ao-root .ao-ver.compact .ao-ver-digit > .unity-base-text-field__input {
    min-height: 18px;
    font-size: 11px;
    border-radius: 4px;
}

.ao-ver.compact .ao-ver-dot {
    font-size: 12px;
    margin: 0 1px;
}

/* ───────────────────────── シーケンス ───────────────────────── */

.ao-seq-row {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    padding: 4px 12px;
    border-bottom-width: 1px;
    border-color: var(--border);
    cursor: link;
}

.ao-seq-row:hover {
    background-color: var(--surface-2);
}

.ao-seq-row.is-on {
    background-color: var(--accent-soft);
}

.ao-seq-row .ao-check {
    margin-right: 12px;
}

.ao-seq-name {
    width: 170px;
    flex-shrink: 0;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ao-seq-file {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 14px;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ao-root Label.ao-seq-file {
    color: var(--text-faint);
}

.ao-seq-row.is-on Label.ao-seq-file {
    color: var(--text-dim);
}

/* ───────────────────────── ファイル一覧（プレビュー） ───────────────────────── */

.ao-file-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 6px;
}

.ao-file-row .ao-icon {
    margin-right: 6px;
}

.ao-file-group {
    margin-top: 8px;
    margin-bottom: 2px;
    -unity-font-style: bold;
    font-size: 11px;
}

.ao-root Label.ao-file-group {
    color: var(--text-dim);
}

/* ───────────────────────── トースト・ダイアログ ───────────────────────── */

.ao-toast-layer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    flex-direction: row;
    justify-content: center;
}

.ao-toast {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-radius: 10px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border-strong);
    border-left-width: 4px;
    border-left-color: var(--success);
    opacity: 0;
    translate: 0 10px;
    transition-duration: 0.2s;
    transition-property: opacity, translate;
}

.ao-toast.is-show {
    opacity: 1;
    translate: 0 0;
}

.ao-toast.warn {
    border-left-color: var(--warn);
}

.ao-toast.danger {
    border-left-color: var(--danger);
}

.ao-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.ao-dialog {
    width: 560px;
    max-width: 90%;
    max-height: 86%;
    padding: 20px 22px;
    border-radius: 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border-strong);
}

.ao-dialog-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ao-dialog-actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 16px;
}

.ao-dialog-actions > .ao-btn {
    margin-left: 8px;
}

.ao-check-item {
    flex-direction: row;
    align-items: flex-start;
    padding: 8px 10px;
    border-radius: 7px;
    background-color: var(--surface-2);
    margin-top: 6px;
}

.ao-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-top: 4px;
    margin-right: 10px;
    background-color: var(--success);
    flex-shrink: 0;
}

.ao-status-dot.warn { background-color: var(--warn); }
.ao-status-dot.danger { background-color: var(--danger); }
.ao-status-dot.info { background-color: var(--accent); }

/* 数値の大きい表示 */
.ao-stat {
    margin-right: 22px;
}

.ao-stat-num {
    font-size: 18px;
    -unity-font-style: bold;
}

.ao-stat-label {
    font-size: 10px;
}

.ao-root Label.ao-stat-label {
    color: var(--text-faint);
}

.ao-header-line {
    border-color: var(--border);
}

.ao-seq-list {
    border-color: var(--border);
}


/* ───────────────────────── 余白ユーティリティ（ボタン等の既定余白より優先） ───────────────────────── */

.ao-root .ao-mt4 { margin-top: 4px; }
.ao-root .ao-mt8 { margin-top: 8px; }
.ao-root .ao-mt12 { margin-top: 12px; }
.ao-root .ao-mt16 { margin-top: 16px; }
.ao-root .ao-ml4 { margin-left: 4px; }
.ao-root .ao-ml6 { margin-left: 6px; }
.ao-root .ao-ml8 { margin-left: 8px; }
.ao-root .ao-ml12 { margin-left: 12px; }
.ao-root .ao-mr6 { margin-right: 6px; }
.ao-root .ao-mr8 { margin-right: 8px; }
.ao-root .ao-mb8 { margin-bottom: 8px; }
/* ───────────────────────── 折り返し防止 ───────────────────────── */

.ao-root .ao-btn {
    white-space: nowrap;
    flex-shrink: 0;
}

.ao-root .ao-btn Label,
.ao-nav-label,
.ao-chip,
.ao-badge,
.ao-kv-key,
.ao-nowrap,
.ao-section-title,
.ao-list-title,
.ao-stepper-label {
    white-space: nowrap;
}

.ao-nowrap,
.ao-kv-key,
.ao-badge,
.ao-chip {
    flex-shrink: 0;
}

.ao-page > .ao-btn {
    align-self: flex-start;
}

.ao-detail-pane {
    min-width: 320px;
}

/* ───────────────────────── 狭いとき（ドッキング時など） ───────────────────────── */

.ao-root.narrow .ao-sidebar {
    width: 58px;
    padding: 12px 8px;
}

.ao-root.narrow .ao-nav-item {
    justify-content: center;
    padding: 0;
}

.ao-root.narrow .ao-nav-label,
.ao-root.narrow .ao-nav-section,
.ao-root.narrow .ao-brand-text,
.ao-root.narrow .ao-sidebar-footer .ao-btn Label {
    display: none;
}

.ao-root.narrow .ao-brand {
    width: 50px;
}

.ao-root.narrow .ao-sidebar-footer .ao-btn {
    justify-content: center;
}

.ao-root.narrow .ao-sidebar-footer .ao-btn .ao-icon {
    margin-right: 0;
}

.ao-root.narrow .ao-list-pane {
    width: 220px;
}

.ao-root.compact .ao-list-pane {
    width: 170px;
}

.ao-root.compact .ao-help-btn {
    display: none;
}

.ao-root.compact .ao-scroll-content {
    padding: 16px 14px 24px 14px;
}

.ao-root.compact .ao-steps-row,
.ao-root.compact .ao-choice-row {
    flex-direction: column;
}

.ao-root.compact .ao-step-card,
.ao-root.compact .ao-choice {
    margin-bottom: 10px;
}
/* hints and toolbars keep their height (prevents overlap in short windows) */
.ao-hint,
.ao-toolbar,
.ao-legend,
.ao-stepper {
    flex-shrink: 0;
}

.ao-asset-list {
    min-height: 140px;
}

.ao-tag {
    transition-duration: 0.2s;
    transition-property: background-color, scale;
}

.ao-tag.is-flash {
    background-color: var(--warn-soft);
    scale: 1.08 1.08;
}
